{
  "name": "nekrasov/nornikel-vacancy-service",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Nekrasov",
      "email": "nekrasov@techart.ru"
    }
  ],
  "require": {
    "php": "^8.3",
    "shuchkin/simplexlsx": "^1.0",
    "symfony/console": "^7.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^7.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.54"
  },
  "bin": [
    "bin/cli.php"
  ],
  "scripts": {
    "lint": "php ./vendor/bin/phpstan analyse src",
    "fix": "php ./vendor/bin/php-cs-fixer fix --allow-risky=yes"
  }
}
